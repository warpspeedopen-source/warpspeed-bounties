# ── Environment ──────────────────────────────────────────────
NODE_ENV=development

# ── AWS SQS ─────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/attachment-events
SQS_POLL_INTERVAL_MS=5000
SQS_VISIBILITY_TIMEOUT=300

# ── Google Cloud Storage ────────────────────────────────────
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
GCS_BUCKET_NAME=warpspeed-attachments

# ── Ollama (self-hosted LLM) ────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=120000

# ── Redis (BullMQ job queue) ────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Database (PostgreSQL via Prisma) ────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warpspeed_summarizer

# ── Server ──────────────────────────────────────────────────
PORT=3000
HEALTH_CHECK_PATH=/health

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
