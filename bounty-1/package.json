{
  "name": "warpspeed-attachment-summarizer",
  "version": "1.0.0",
  "description": "AWS SQS → GCS download → content extraction → LLM summarization service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "docker:build": "docker build -t attachment-summarizer .",
    "docker:run": "docker-compose up -d"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.600.0",
    "@google-cloud/storage": "^7.12.0",
    "@prisma/client": "^5.17.0",
    "axios": "^1.7.0",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "mammoth": "^1.8.0",
    "morgan": "^1.10.0",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.33.0",
    "tesseract.js": "^5.1.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "yargs": "^17.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/mammoth": "^0.2.3",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "@types/yargs": "^17.0.32",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "prisma": "^5.17.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": ["warpspeed", "attachment", "summarizer", "llm", "sqs", "gcs"],
  "license": "MIT"
}
