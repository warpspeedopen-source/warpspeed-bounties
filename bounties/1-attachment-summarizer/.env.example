# ==============================================================================
# AWS SQS Configuration
# ==============================================================================
AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/my-attachment-queue

# Optional: AWS Credentials (if not using IAM Roles or AWS CLI Profiles)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ==============================================================================
# Google Cloud Storage (GCS) Configuration
# ==============================================================================
# Path to your GCS service account json credentials file (if running locally)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
GOOGLE_CLOUD_PROJECT=my-gcp-project-id

# ==============================================================================
# Local Ollama LLM Configuration
# ==============================================================================
# Host URL for local Ollama.
# If running this service inside a Docker container and Ollama is on the host, 
# use http://host.docker.internal:11434 (mac/win) or system IP.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ==============================================================================
# Application Logging Settings
# ==============================================================================
# Options: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
NODE_ENV=development
