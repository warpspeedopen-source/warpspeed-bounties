generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AttachmentSummary {
  id             String   @id
  filename       String
  mime           String
  bucket         String
  object         String
  summary        String
  extractedChars Int
  createdAt      DateTime @default(now())
}
