# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# Set DATABASE_URL to enable Prisma/PostgreSQL persistence
# If not set, the API uses InMemoryRepository (for development/testing)
DATABASE_URL="postgresql://user:password@localhost:5432/email_threads?schema=public"

# JWT Authentication (optional, current implementation uses token-based auth)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="24h"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Logging
LOG_LEVEL="debug"
