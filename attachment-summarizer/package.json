{
  "name": "attachment-summarizer",
  "version": "0.1.0",
  "description": "Service that consumes SQS attachment events, downloads files from GCS, extracts content, summarizes with Ollama, and stores results in a database.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.658.0",
    "@google-cloud/storage": "^7.13.0",
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "prisma": "^5.20.0",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1",
    "winston": "^3.14.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}