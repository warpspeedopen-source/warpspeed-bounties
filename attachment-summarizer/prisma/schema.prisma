datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AttachmentSummary {
  id           String   @id @default(uuid())
  messageId    String   @unique
  bucket       String
  objectKey    String
  summary      String
  status       String   @default("COMPLETED") // COMPLETED, ERROR
  errorMessage String?
  createdAt    DateTime @default(now())
}
